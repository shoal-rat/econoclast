# Econoclast API keys — copy to ".env" and fill in the providers you use.
# You only need the keys for the providers referenced in your model routing
# (see econoclast.example.yaml). Everything statistical works with NO keys.

# --- OpenAI (and OpenAI-compatible) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google Gemini ---
GOOGLE_API_KEY=
# GEMINI_API_KEY is accepted as an alias

# --- OpenRouter (one key, hundreds of models) ---
OPENROUTER_API_KEY=

# --- Local models via Ollama / vLLM / LM Studio (OpenAI-compatible) ---
# No API key needed; just point a provider at the base URL.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional: polite pool e-mail for OpenAlex / Crossref (higher rate limits) ---
ECONOCLAST_CONTACT_EMAIL=
# --- Optional: Semantic Scholar API key (higher rate limits; works without) ---
SEMANTIC_SCHOLAR_API_KEY=
